---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { languages, navLinks } from '@/data/site';

const current = languages[0]!;
---

<header class="header" data-header>
  <div class="container header__inner">
    <a href="#topo" class="header__brand" aria-label="Bitzar Solutions — início">
      <Logo showTag />
    </a>

    <button
      type="button"
      class="header__menu-btn"
      aria-expanded="false"
      aria-controls="main-nav"
      data-menu-toggle
    >
      <span class="sr-only">Abrir menu</span>
      <span class="header__burger" aria-hidden="true"></span>
    </button>

    <nav id="main-nav" class="header__nav" aria-label="Principal" data-menu>
      <ul class="header__links">
        {
          navLinks.map((link) => (
            <li>
              <a href={link.href} class="header__link">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="header__actions">
        <a href="#diagnostico" class="btn btn--primary header__cta">Faça um diagnóstico</a>

        <div class="lang" data-lang>
          <button
            type="button"
            class="lang__btn"
            aria-haspopup="true"
            aria-expanded="false"
            aria-controls="lang-menu"
            aria-label={`Alterar idioma (atual: ${current.name})`}
            data-lang-toggle
          >
            <Icon name="globe" size={16} strokeWidth={1.75} />
            <span data-lang-current>{current.short}</span>
            <Icon name="chevron-down" size={12} strokeWidth={2} class="lang__chevron" />
          </button>

          <ul id="lang-menu" class="lang__menu" hidden data-lang-menu>
            {
              languages.map((lang) => (
                <li>
                  <button
                    type="button"
                    class="lang__option"
                    lang={lang.code}
                    data-lang-option={lang.code}
                    data-lang-short={lang.short}
                    aria-current={lang.code === current.code ? 'true' : undefined}
                  >
                    {lang.name}
                    <Icon name="check" size={16} strokeWidth={2.5} class="lang__check" />
                  </button>
                </li>
              ))
            }
          </ul>
        </div>

      </div>
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--white);
    border-bottom: 1px solid var(--line);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-block: 16px;
  }

  .header__brand {
    text-decoration: none;
  }

  .header__nav {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .header__links {
    display: flex;
    gap: 4px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .header__link {
    display: block;
    padding: 12px 14px;
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
    border-radius: var(--radius-sm);
  }

  .header__link:hover {
    background: var(--bg-soft);
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-left: 8px;
  }

  .header__cta {
    font-size: 15px;
    min-height: 44px;
    padding: 0 20px;
  }

  /* Seletor de idioma */
  .lang {
    position: relative;
  }

  .lang__btn {
    display: flex;
    align-items: center;
    gap: 4px;
    min-height: 44px;
    padding: 0 8px;
    border: none;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--text-muted);
    font-family: inherit;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.02em;
    cursor: pointer;
    transition: color 0.15s, background-color 0.15s;
  }

  .lang__btn:hover,
  .lang__btn[aria-expanded='true'] {
    color: var(--navy);
    background: var(--bg-soft);
  }

  .lang__btn[aria-expanded='true'] :global(.lang__chevron) {
    transform: rotate(180deg);
  }

  :global(.lang__chevron) {
    transition: transform 0.15s;
  }

  .lang__menu {
    position: absolute;
    right: 0;
    top: calc(100% + 8px);
    width: 180px;
    margin: 0;
    padding: 6px;
    list-style: none;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 8px;
    box-shadow: 0 8px 24px rgb(11 27 58 / 0.12);
    z-index: 60;
  }

  .lang__option {
    display: flex;
    width: 100%;
    justify-content: space-between;
    align-items: center;
    min-height: 44px;
    padding: 0 12px;
    border: none;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--navy);
    font-family: inherit;
    font-size: 15px;
    text-align: left;
    cursor: pointer;
  }

  .lang__option:hover {
    background: var(--bg-soft);
  }

  .lang__option :global(.lang__check) {
    visibility: hidden;
  }

  .lang__option[aria-current='true'] {
    font-weight: 600;
  }

  .lang__option[aria-current='true'] :global(.lang__check) {
    visibility: visible;
  }

  /* Menu mobile */
  .header__menu-btn {
    display: none;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    background: var(--white);
    cursor: pointer;
    align-items: center;
    justify-content: center;
  }

  .header__burger,
  .header__burger::before,
  .header__burger::after {
    display: block;
    width: 18px;
    height: 2px;
    background: var(--navy);
    border-radius: 1px;
    transition: transform 0.2s, background-color 0.2s;
  }

  .header__burger {
    position: relative;
  }

  .header__burger::before,
  .header__burger::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .header__burger::before {
    top: -6px;
  }

  .header__burger::after {
    top: 6px;
  }

  .header__menu-btn[aria-expanded='true'] .header__burger {
    background: transparent;
  }

  .header__menu-btn[aria-expanded='true'] .header__burger::before {
    transform: translateY(6px) rotate(45deg);
  }

  .header__menu-btn[aria-expanded='true'] .header__burger::after {
    transform: translateY(-6px) rotate(-45deg);
  }

  @media (max-width: 960px) {
    .header__menu-btn {
      display: inline-flex;
    }

    .header__nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 12px;
      padding: 12px var(--gutter) 20px;
      background: var(--white);
      border-bottom: 1px solid var(--line);
      box-shadow: 0 12px 24px rgb(11 27 58 / 0.08);
    }

    .header__nav.is-open {
      display: flex;
    }

    .header__links {
      flex-direction: column;
    }

    .header__actions {
      margin-left: 0;
      justify-content: space-between;
    }

    .header__cta {
      flex: 1;
    }

    .lang__menu {
      right: 0;
      left: auto;
      top: auto;
      bottom: calc(100% + 8px);
    }
  }
</style>

<script>
  import type { LanguageCode } from '@/data/site';

  const STORAGE_KEY = 'bitzar:lang';

  // ---------- Menu mobile ----------
  const menuToggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');

  function setMenu(open: boolean): void {
    if (!menuToggle || !menu) return;
    menu.classList.toggle('is-open', open);
    menuToggle.setAttribute('aria-expanded', String(open));
    const label = menuToggle.querySelector('.sr-only');
    if (label) label.textContent = open ? 'Fechar menu' : 'Abrir menu';
  }

  menuToggle?.addEventListener('click', () => {
    setMenu(menuToggle.getAttribute('aria-expanded') !== 'true');
  });

  // Fecha o menu mobile ao clicar em um link
  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setMenu(false));
  });

  // ---------- Seletor de idioma ----------
  const langRoot = document.querySelector<HTMLElement>('[data-lang]');
  const langToggle = document.querySelector<HTMLButtonElement>('[data-lang-toggle]');
  const langMenu = document.querySelector<HTMLUListElement>('[data-lang-menu]');
  const langCurrent = document.querySelector<HTMLElement>('[data-lang-current]');
  const options = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-lang-option]'));

  function setLangMenu(open: boolean): void {
    if (!langToggle || !langMenu) return;
    langMenu.hidden = !open;
    langToggle.setAttribute('aria-expanded', String(open));
    if (open) {
      const active = options.find((o) => o.getAttribute('aria-current') === 'true') ?? options[0];
      active?.focus();
    }
  }

  function applyLanguage(code: LanguageCode): void {
    const option = options.find((o) => o.dataset.langOption === code);
    if (!option || !langCurrent || !langToggle) return;

    options.forEach((o) => o.removeAttribute('aria-current'));
    option.setAttribute('aria-current', 'true');
    langCurrent.textContent = option.dataset.langShort ?? code;
    langToggle.setAttribute('aria-label', `Alterar idioma (atual: ${option.textContent?.trim()})`);
    document.documentElement.lang = code;

    // Ponto de extensão: aqui entraria a troca real do conteúdo (ex.: redirecionar para /en/).
    document.dispatchEvent(new CustomEvent<LanguageCode>('bitzar:language-change', { detail: code }));
  }

  function readSavedLanguage(): LanguageCode | null {
    try {
      const saved = localStorage.getItem(STORAGE_KEY);
      return saved === 'pt-BR' || saved === 'en' || saved === 'es' ? saved : null;
    } catch {
      return null;
    }
  }

  const saved = readSavedLanguage();
  if (saved) applyLanguage(saved);

  langToggle?.addEventListener('click', () => {
    setLangMenu(langToggle.getAttribute('aria-expanded') !== 'true');
  });

  options.forEach((option) => {
    option.addEventListener('click', () => {
      const code = option.dataset.langOption as LanguageCode;
      applyLanguage(code);
      try {
        localStorage.setItem(STORAGE_KEY, code);
      } catch {
        /* armazenamento indisponível: segue sem salvar */
      }
      setLangMenu(false);
      langToggle?.focus();
    });
  });

  // Fecha ao clicar fora
  document.addEventListener('click', (event) => {
    if (langRoot && !langRoot.contains(event.target as Node)) setLangMenu(false);
  });

  // Teclado: Esc fecha, setas navegam entre opções
  langRoot?.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      setLangMenu(false);
      langToggle?.focus();
      return;
    }
    if (langMenu?.hidden) return;
    const index = options.indexOf(document.activeElement as HTMLButtonElement);
    if (event.key === 'ArrowDown') {
      event.preventDefault();
      options[(index + 1) % options.length]?.focus();
    } else if (event.key === 'ArrowUp') {
      event.preventDefault();
      options[(index - 1 + options.length) % options.length]?.focus();
    }
  });
</script>