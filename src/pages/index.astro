---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Hero from '@/components/Hero.astro';
import Clients from '@/components/Clients.astro';
import Services from '@/components/Services.astro';
import About from '@/components/About.astro';
import HowWeWork from '@/components/HowWeWork.astro';
import Cases from '@/components/Cases.astro';
import Diagnostic from '@/components/Diagnostic.astro';
import Footer from '@/components/Footer.astro';
import ChatAssistant from '@/components/ChatAssistant.astro';
import { getDictionary } from '@/i18n';

const chat = getDictionary('pt').chat;
---

<BaseLayout>
  <Header />
  <main>
    <Hero />
    <Clients />
    <Services />
    <About />
    <HowWeWork />
    <Cases />
    <Diagnostic />
  </main>
  <Footer />
  <ChatAssistant t={chat} />
</BaseLayout>