---
import { clientLogos } from '@/data/site';
import type { Dictionary } from '@/i18n';

interface Props {
  t: Dictionary['clients'];
}

const { t } = Astro.props;
---

<section class="clients" aria-labelledby="clients-title">
  <div class="container clients__inner">
    <p id="clients-title" class="clients__title">{t.title}</p>
    <ul class="clients__grid">
      {
        clientLogos.map((logo) => (
          <li class="clients__logo">
            {logo.src ? (
              <img
                src={logo.src}
                alt={logo.name}
                loading="lazy"
                decoding="async"
                style={`--scale: ${logo.scale ?? 1}`}
              />
            ) : (
              <span class="clients__placeholder">{logo.name}</span>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .clients {
    background: var(--bg-soft);
    border-block: 1px solid var(--line);
  }

  .clients__inner {
    padding-block: 52px;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .clients__title {
    font-family: var(--font-display);
    font-size: clamp(17px, 1.6vw, 20px);
    font-weight: 600;
    color: var(--text);
    text-align: center;
  }

  .clients__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 24px;
  }

  .clients__logo {
    height: 80px;
    padding: 0 20px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .clients__logo img {
    /* --scale (definido no site.ts) aumenta logos com muita margem em volta, sem passar da caixa */
    max-height: min(calc(44px * var(--scale, 1)), 58px);
    max-width: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    /* Faz o fundo branco dos .jpeg "sumir" sobre o cinza */
    mix-blend-mode: multiply;
    filter: grayscale(1);
    opacity: 0.8;
    transition: filter 0.2s, opacity 0.2s;
  }

  .clients__logo:hover img {
    filter: none;
    opacity: 1;
  }

  .clients__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px dashed var(--line-input);
    border-radius: 8px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-faint);
  }

  @media (max-width: 900px) {
    .clients__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 720px) {
    .clients__inner {
      padding-block: 40px;
      gap: 20px;
    }

    .clients__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 12px;
    }

    .clients__logo {
      height: 64px;
      padding: 0 8px;
    }

    .clients__logo img {
      max-height: min(calc(30px * var(--scale, 1)), 42px);
    }
  }
</style>