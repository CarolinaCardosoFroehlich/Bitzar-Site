---
import type { Dictionary } from '@/i18n';

interface Props {
  t: Dictionary['howWeWork'];
}

const { t } = Astro.props;
---

<section id="como-trabalhamos" class="section section--soft">
  <div class="container how">
    <div class="how__head">
      <p class="eyebrow">{t.eyebrow}</p>
      <h2 class="h2">{t.title}</h2>
      <p class="lead">{t.lead}</p>
    </div>

    <ol class="how__grid">
      {
        t.items.map((model, i) => (
          <li class="model">
            <p class="model__number">
              {t.modelLabel} {String(i + 1).padStart(2, '0')}
            </p>
            <h3 class="model__title">{model.title}</h3>
            <p class="model__desc">{model.description}</p>
            <p class="model__ideal">
              {t.idealForLabel} {model.idealFor}
            </p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .how {
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .how__head {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 680px;
  }

  .how__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: 20px;
  }

  .model {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 32px;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .model__number {
    font-family: var(--font-mono);
    font-size: 12px;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .model__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 24px;
  }

  .model__desc {
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-2);
  }

  .model__ideal {
    margin-top: auto;
    font-size: 14px;
    font-weight: 600;
  }
</style>